{
  "grammar": 1,
  "card": {
    "background": "linear-gradient(150deg, #fff1f4, #fbd9e3)",
    "border_radius": "32px",
    "padding": "20px",
    "border_width": "1px",
    "border_style": "solid",
    "border_color": "#f2b8c9",
    "box_shadow": "0 10px 26px rgba(214,108,140,0.25)"
  },
  "modules": {
    "*": {
      "design": {
        "color": "#6b2a44",
        "font_family": "ui-rounded, system-ui, sans-serif",
        "font_weight": "600"
      }
    },
    "icon": {
      "icon_color": "#d6538a"
    },
    "bar": {
      "bar_color": "#d6538a",
      "bar_background": "#f4c9d8",
      "bar_height": "10px"
    },
    "slider": {
      "track_style": "pill",
      "slider_color": "#d6538a",
      "track_color": "#f4c9d8",
      "track_thickness": 12,
      "thumb": "circle",
      "thumb_size": 20,
      "thumb_border": 3,
      "thumb_border_color": "#ffffff"
    },
    "button": {
      "design": {
        "background": "#d6538a",
        "color": "#fff5f8",
        "border_radius": "999px"
      }
    }
  }
}
