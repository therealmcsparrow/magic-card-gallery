{
  "grammar": 1,
  "card": {
    "background": "linear-gradient(145deg, rgba(30,41,80,0.72), rgba(12,18,40,0.82))",
    "border_radius": "24px",
    "padding": "16px",
    "border_width": "1px",
    "border_style": "solid",
    "border_color": "rgba(255,255,255,0.16)",
    "backdrop_filter": "blur(18px) saturate(140%)",
    "box_shadow": "0 12px 40px rgba(0,0,0,0.45)"
  },
  "modules": {
    "*": {
      "design": {
        "color": "#e8ecff",
        "font_family": "system-ui, sans-serif",
        "font_weight": "500"
      }
    },
    "icon": {
      "icon_color": "#9db4ff"
    },
    "bar": {
      "bar_color": "#7aa2ff",
      "bar_background": "rgba(255,255,255,0.12)",
      "bar_height": "8px"
    },
    "slider": {
      "track_style": "glass",
      "glass_blur": true,
      "slider_color": "#7aa2ff",
      "slider_color_to": "#b69cff",
      "fill_mode": "gradient",
      "thumb": "circle",
      "thumb_size": 18
    },
    "button": {
      "design": {
        "background": "rgba(255,255,255,0.1)",
        "border_radius": "14px",
        "border": "1px solid rgba(255,255,255,0.18)"
      }
    }
  }
}
